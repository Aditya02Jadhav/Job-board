# LangGraph model provider: auto chooses Groq when its key exists, otherwise Gemini.
# The pipeline is pinned to models currently listed in each provider's free tier.
LLM_PROVIDER=auto
GROQ_API_KEY=
# Optional Groq failover key. Add more as GROQ_API_KEY_3, GROQ_API_KEY_4, etc.
GROQ_API_KEY_2=
# Optional free-tier fallback used in auto mode after all Groq keys hit daily quota.
GEMINI_API_KEY=
# Optional Gemini quota-failover key; additional keys can use GEMINI_API_KEY_3, etc.
GEMINI_API_KEY_2=

# Groq's free tier is token-limited; space requests to avoid TPM throttling.
# Increase this for lower account limits or set to 0 for providers with higher limits.
LLM_REQUEST_INTERVAL_SECONDS=15

# Optional Adzuna API credentials. Register and review the current API terms first.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Public Greenhouse and Lever boards verified for India hiring; override with
# a JSON array to select a different set, or [] to disable ATS boards.
COMPANY_BOARDS=[{"provider":"greenhouse","board":"groww","company":"Groww"},{"provider":"greenhouse","board":"stripe","company":"Stripe"},{"provider":"greenhouse","board":"gitlab","company":"GitLab"},{"provider":"greenhouse","board":"coinbase","company":"Coinbase"},{"provider":"greenhouse","board":"datadog","company":"Datadog"},{"provider":"lever","board":"meesho","company":"Meesho"},{"provider":"lever","board":"cred","company":"CRED"},{"provider":"lever","board":"zeta","company":"Zeta"},{"provider":"ashby","board":"sarvam","company":"Sarvam"},{"provider":"ashby","board":"ema","company":"Ema"},{"provider":"ashby","board":"plane","company":"Plane"},{"provider":"ashby","board":"aiprise","company":"AiPrise"}]

# Jobicy returns up to 100 jobs per page, with at least one second between requests.
JOBICY_MAX_PAGES_PER_GEO=5
